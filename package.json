{
  "name": "vedis-cli",
  "version": "0.2.0",
  "description": "Vedis CLI — MCP-native agent security proxy + conversational red-team runner. The thin client for the Vedis hybrid deployment (deep analysis runs on the operator's engine).",
  "type": "module",
  "bin": {
    "vedis": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "yaml": "^2.4.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sypherin/vedis-cli"
  },
  "keywords": [
    "mcp",
    "security",
    "ai-agent",
    "prompt-injection",
    "red-team",
    "vedis"
  ]
}
